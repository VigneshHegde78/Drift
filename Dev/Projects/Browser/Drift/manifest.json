{
  "manifest_version": 3,
  "name": "Drift",
  "version": "0.1.0",
  "description": "A minimal screen-time tracker.",

  "permissions": ["tabs"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
